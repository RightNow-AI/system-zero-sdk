        },
        "required": [
          "model",
          "state",
          "questions"
        ],
        "additionalProperties": false,
        "description": "Stateless long context for an admitted workspace, when canonical state bytes plus text-document bytes exceed 131072. Only inline document attachments are allowed. At most 32 questions; choices take 2 to 25 options."
      },
      "EnabledDecideRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DecideRequest"
          },
          {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrdinaryRequest"
              },
              {
                "$ref": "#/components/schemas/MediaRequest"
              },
              {
                "$ref": "#/components/schemas/LongContextRequest"
              }
            ]
          }
        ],
        "description": "Served request alternatives. The gateway selects the ordinary or long context band from canonical state bytes and resolved text-document bytes, and admits long context only for a workspace granted that feature. Image or audio attachments use the media range. One silent inline video uses the text range and cannot be combined with any other attachment."
      },
      "LongContextLimits": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_tokens",
          "rendered_tokens",
          "questions",
          "question_tokens",
          "question_bytes",
          "choice_options",
          "score_levels",
          "attachments",
          "body_bytes",
          "inline_attachment_bytes"
        ],
        "properties": {
          "state_tokens": {
            "type": "integer",
            "description": "The longest state one request answers, counted in state tokens. A longer state is refused with 404 long_context_not_available while long_context is held."
          },
          "rendered_tokens": {
            "type": "integer",
            "description": "The longest rendered context one request answers, counted in rendered tokens: the state with each question rendered beside it. A longer one is refused with 404 long_context_not_available while long_context is held. Body bytes and the HTTP answer bound still apply independently."
          },
          "questions": {
            "type": "integer",
            "description": "The most questions one request may ask."
          },
          "question_tokens": {
            "type": "integer"
          },
          "question_bytes": {
