  "paths": {
    "/system-zero/decide": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnabledDecideRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "See the served API response contract."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DecideRequest": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "state": {
            "$ref": "#/components/schemas/StructuredJson"
          },
          "attachments": {
            "anyOf": [
              {
                "maxItems": 16,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Attachment"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "questions": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "minProperties": 1,
            "maxProperties": 1024,
            "additionalProperties": {
              "$ref": "#/components/schemas/Question"
            }
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "prompt_cache_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "route": {
            "type": "string",
            "enum": [
              "standard",
              "committee"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "standard",
              "deliberate"
            ]
          }
        },
        "required": [
          "model",
          "state",
          "questions"
        ],
        "additionalProperties": false,
        "description": "Send one silent H.264 MP4 video as an inline base64 data URL. Maximum duration: 10 seconds. Maximum dimensions: 1920 x 1080. Maximum decoded file size: 2,621,440 bytes (2.5 MiB). The complete JSON request must fit 3,665,920 bytes, including base64 and questions. Frames are sampled at 2 per second from time zero, up to 20 frames. Rotated videos, soundtracks, separate attachments and video upload references are not supported.",
        "allOf": [
          {
            "if": {
              "required": [
                "attachments"
              ],
              "properties": {
                "attachments": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "video"
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "attachments": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "type",
                      "data"
                    ],
                    "properties": {
                      "type": {
                        "const": "video"
                      },
                      "data": {
                        "type": "string",
                        "pattern": "^data:video/mp4;base64,"
                      }
                    },
                    "not": {
                      "required": [
                        "upload"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "document",
              "image",
              "audio",
              "video"
            ]
          },
          "data": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "data"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "mime"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "text",
              "mime"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "data"
                  ]
                }
              ]
            }
          }
        ],
        "description": "Exactly one of data (a base64 data URL) or text (with its mime, a text document). Kinds and types: When documents are available: document application/pdf; image image/png, image/jpeg, image/webp, image/gif; audio audio/wav; video video/mp4. When audio is available: Audio must be WAV (PCM or float) at a 16,000 Hz sample rate. Other audio formats are unsupported. Mono and multichannel files are accepted. Documents accept inline PDF only, at most 500 pages and at most 2,621,440 decoded inline bytes per request. Encrypted PDFs are not supported. Other document formats return 415 document_unsupported (pdf_required). Document references are refused as unpriced."
      },
