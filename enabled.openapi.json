              "criteria"
            ],
            "additionalProperties": false
          }
        ]
      },
      "StructuredJson": {
        "description": "Text, or a JSON object or array; every number finite (an integer past 2^53 - 1 reaches the node digit for digit).",
        "anyOf": [
